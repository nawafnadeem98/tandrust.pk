# Sehat Pakistan — Production Environment Variables
# Copy this file, rename to .env.production, and fill in real values
# Then add each variable in Vercel Dashboard → Settings → Environment Variables

# ── Database ──────────────────────────────────────────────────────────────────
# Get this from https://neon.tech (free PostgreSQL hosting)
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/sehatpakistan?sslmode=require"

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong random secret (run in terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_32_CHARS"
NEXTAUTH_SECRET="REPLACE_WITH_ANOTHER_STRONG_RANDOM_SECRET"

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://sehatpakistan.com"

# ── App Settings ─────────────────────────────────────────────────────────────
NODE_ENV="production"
TELEHEALTH_ENABLED="false"

# ── Email (optional — leave blank to disable email features) ──────────────────
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
